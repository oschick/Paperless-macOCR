{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    "group:allNonMajor"
  ],
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "packageRules": [
    {
      "description": "The Python version is its own PR, outside every group: a new Python needs its own check",
      "matchDepNames": [
        "python"
      ],
      "groupName": "python version"
    }
  ]
}
